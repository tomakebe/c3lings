// =====================================================================
//  080 · Вариадические макросы `$vaarg`
// =====================================================================
//
//  В упражнении 049 были вариадические ФУНКЦИИ: `int... xs` (все
//  аргументы одного типа, приходят срезом) и `args...` (приходят как
//  `any[]`, тип проверяется в рантайме). Макросы умеют и это, и кое-что
//  ещё: «сырые» аргументы, объявляемые просто как `...`:
//
//      macro sum(...)
//      {
//          var total = $vaarg[0];
//          $for var $i = 1; $i < $vaarg.len; $i++:
//              total += $vaarg[$i];
//          $endfor
//          return total;
//      }
//
//  Что тут есть:
//    * `$vaarg.len` — количество аргументов (константа компиляции);
//    * `$vaarg[$i]` — i-й аргумент как НЕВЫЧИСЛЕННОЕ выражение (как
//      `#`-параметр!): каждое упоминание вычисляет его заново. Индекс
//      должен быть константой компиляции, поэтому обход идёт через
//      compile-time цикл `$for ... $endfor` (подробно — в 082). Цикл
//      разворачивается: для трёх аргументов получится три строки кода;
//    * у каждого аргумента СВОЙ тип: `@dbg(x, y)` с int и double —
//      никаких `any`, всё проверено при компиляции;
//    * `$stringify($vaarg[$i])` — текст аргумента;
//    * `$Typefrom($vaarg[$i])` — если аргумент — тип;
//    * `...$vaarg` — «расплющить» все аргументы в вызов функции или
//      инициализатор: `foo(...$vaarg)`, `int[*] a = { ...$vaarg };`.
//      Можно взять диапазон: `...$vaarg[1..]` — всё, кроме первого.
//
//  `...` можно сочетать с обычными параметрами: `macro max_of(first, ...)`
//  — тогда первый аргумент обязателен, а `$vaarg` — остальные.
//
//  Сравнение с C: `#define LOG(fmt, ...) printf(fmt, __VA_ARGS__)` —
//  та же идея «вставить аргументы», но без типов, без счётчика, без
//  обхода по одному. В C++ ближайший аналог — variadic templates с
//  fold-выражениями или рекурсией.
//
//  Поскольку `$vaarg[i]` ленивый, макросу, который его использует для
//  вычислений, не нужен `@`, если он ведёт себя как функция, — но
//  будьте внимательны с побочными эффектами при многократном
//  упоминании.
//
//  ЗАДАЧА:
//    1. В `@dbg` напечатайте для каждого аргумента «текст = значение».
//    2. Реализуйте `max_of(first, ...)` — максимум из всех аргументов.
//    3. Допишите `call_tail`: вызовите `add3` со всеми аргументами,
//       КРОМЕ первого (через расплющивание).
//
import std::io;

macro sum(...)
{
    var total = $vaarg[0];
    $for var $i = 1; $i < $vaarg.len; $i++:
        total += $vaarg[$i];
    $endfor
    return total;
}

macro void @dbg(...)
{
    $for var $i = 0; $i < $vaarg.len; $i++:
        // TODO: напечатайте "текст = значение" для $i-го аргумента
    $endfor
}

macro max_of(first, ...)
{
    // TODO: найдите максимум среди first и всех $vaarg.
    return first;
}

macro usz count(...) => $vaarg.len;

fn int add3(int a, int b, int c) => a * 100 + b * 10 + c;

macro call_tail(...)
{
    return add3(???);
}

macro to_array(...)
{
    int[*] arr = { ...$vaarg };
    return arr;
}

fn void main()
{
    assert(sum(1, 2, 3, 4) == 10);
    io::printfn("sum(1, 2, 3, 4) = %d", sum(1, 2, 3, 4));
    io::printfn("sum(1.5, 2.25) = %.2f", sum(1.5, 2.25));

    int hp = 70;
    double speed = 2.5;
    String name = "orc";
    @dbg(hp, speed, name, hp * 2);

    assert(max_of(3, 9, 2, 8) == 9);
    assert(max_of(42) == 42);
    io::printfn("max_of(3, 9, 2, 8) = %d", max_of(3, 9, 2, 8));
    io::printfn("max_of(0.5, -1.0) = %.1f", max_of(0.5, -1.0));

    io::printfn("count() = %d, count(1, \"a\", 2.0) = %d", count(), count(1, "a", 2.0));

    assert(call_tail(999, 1, 2, 3) == 123);
    io::printfn("call_tail(999, 1, 2, 3) = %d", call_tail(999, 1, 2, 3));

    io::printfn("to_array(4, 5, 6) = %s", to_array(4, 5, 6));
}
