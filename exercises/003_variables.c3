// =====================================================================
//  003 · Переменные
// =====================================================================
//
//  Переменная объявляется как в C: сначала тип, потом имя.
//
//      int apples = 3;     // объявление с инициализацией
//      int pears;          // без инициализатора
//      pears = 5;          // присваивание
//
//  НУЛЕВАЯ ИНИЦИАЛИЗАЦИЯ ПО УМОЛЧАНИЮ
//  В C локальная переменная без инициализатора содержит мусор, и
//  чтение её — неопределённое поведение. В C3 ВСЕ переменные (и
//  глобальные, и локальные) без инициализатора заполняются нулями.
//  `int pears;` — это ровно 0. Если вам действительно нужна
//  неинициализированная память (ради скорости), это пишется явно:
//  `int x @noinit;`.
//
//  НЕСКОЛЬКО ПЕРЕМЕННЫХ В ОДНОЙ СТРОКЕ
//  `int a, b;` — можно, но ТОЛЬКО без инициализаторов. Сишное
//  `int a, b = 4;` запрещено: слишком легко подумать, что `a` тоже
//  равно 4. Объявляйте такие переменные по отдельности.
//
//  ЗАТЕНЕНИЕ (shadowing) ЗАПРЕЩЕНО
//  Во вложенном блоке нельзя объявить переменную с тем же именем, что
//  и снаружи: компилятор скажет "would shadow a previous declaration".
//  Хотите изменить внешнюю переменную — просто присвойте ей значение.
//
//  ИМЕНА
//  Переменные и функции пишутся с маленькой буквы (`snake_case`),
//  типы — с заглавной (`Player`), константы — ЗАГЛАВНЫМИ. Компилятор
//  этого требует, а не просто советует.
//
//  `var` — ВЫВОД ТИПА
//  Ключевое слово `var` выводит тип из инициализатора, но в обычной
//  функции оно запрещено: C3 предпочитает, чтобы тип был виден явно.
//  `var` нужен в макросах и для compile-time переменных (`var $i`), а
//  в обычном коде пишется с явным разрешением: `var x @safeinfer = 10;`.
//  Пока просто пишите тип.
//
//  Функция `assert(условие)` проверяет условие во время выполнения
//  и аварийно завершает программу, если оно ложно. Мы будем часто
//  использовать её, чтобы программа сама проверяла себя.
//
//  ЗАДАЧА: исправьте три ошибки компиляции (отмечены `// <-`).
//  Программа должна напечатать:
//
//      apples=3 pears=4 score=17
//
import std::io;

fn void main()
{
    int apples, pears = 4;          // <- нельзя инициализировать в такой форме

    int score;
    assert(score == 0);             // переменная обнулена автоматически

    apples = 3;
    score = apples + pears;

    {
        var bonus = 10;             // <- `var` в обычной функции запрещён
        int score = score + bonus;  // <- хотели увеличить внешний score
    }

    assert(score == 17);
    io::printfn("apples=%d pears=%d score=%d", apples, pears, score);
}
