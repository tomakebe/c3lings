// =====================================================================
//  022 · Строки: String, ZString, raw-строки
// =====================================================================
//
//  STRING
//  Основной строковый тип C3 — `String`. По сути это срез байт
//  `char[]`: указатель + длина. Значит:
//  * длина известна сразу: `s.len` (без strlen, за O(1));
//  * строка НЕ обязана заканчиваться нулём (срез из середины другой
//    строки — тоже String);
//  * индексация `s[0]`, срезы `s[1..3]`, `foreach (c : s)` — всё как у
//    срезов.
//  Содержимое — байты UTF-8; `len` — число БАЙТ, а не символов.
//
//  ZSTRING
//  `ZString` — сишная строка с нулём в конце (по сути `char*`). Она
//  нужна для вызова C-функций. Длину приходится считать: `z.len()`
//  проходит до нуля (как strlen).
//  Строковый литерал "..." подходит для обоих типов. А вот между собой
//  они неявно не преобразуются:
//      ZString -> String:  `z.str_view()`  (вид на те же байты)
//      String -> ZString:  нужна копия с нулём на конце (`s.zstr_tcopy()`)
//
//  СРАВНЕНИЕ
//  В C `a == b` для строк сравнивает АДРЕСА, и нужно звать strcmp.
//  В C3 `==` для String сравнивает СОДЕРЖИМОЕ: `"abc" == s` — то, что
//  вы и ожидаете.
//
//  ESCAPE-ПОСЛЕДОВАТЕЛЬНОСТИ И RAW-СТРОКИ
//  В обычной строке `\` начинает escape-последовательность (`\n`,
//  `\t`, `\\`, `\"`...). Неизвестная последовательность (вроде `\g`) —
//  ошибка компиляции "Invalid escape in string".
//  Raw-строка пишется в обратных кавычках `...` и берётся БУКВАЛЬНО:
//  обратные косые остаются как есть, а перевод строки внутри — просто
//  часть строки. Удобно для путей Windows, регулярных выражений,
//  многострочного текста.
//
//      String path = `C:\games\new`;      // ровно то, что написано
//
//  Соседние литералы склеиваются: "abc" "def" == "abcdef".
//
//  ЗАДАЧА: исправьте три места с `// <-`. Программа должна напечатать:
//
//      path: C:\games\new (12 bytes)
//      title: Hello (5 bytes)
//      command is quit
//      'l' count: 3
//
import std::io;

fn void main()
{
    String path = "C:\games\new";                 // <- обратные косые должны остаться как есть
    io::printfn("path: %s (%d bytes)", path, path.len);

    ZString c_title = "Hello";                    // как будто пришло из C-библиотеки
    String title = c_title;                       // <- ZString в String неявно не превращается
    io::printfn("title: %s (%d bytes)", title, title.len);

    String input = "quit now";
    String command = input[0:4];                  // срез строки — тоже String
    if (command == "quit") io::printn("command is quit");

    int count = 0;
    foreach (c : "hello world")
    {
        if (c == ???) count++;                    // <- символьный литерал буквы l
    }
    io::printfn("'l' count: %d", count);
}
