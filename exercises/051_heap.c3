// =====================================================================
//  051 · Куча: malloc/free, mem::new, mem::new_array
// =====================================================================
//
//  До сих пор все наши данные жили на стеке: локальные переменные,
//  массивы фиксированного размера, структуры. Стек быстрый, но у него
//  два ограничения:
//    * размер должен быть известен заранее (int[100], а не int[n]);
//    * данные умирают, когда функция возвращается.
//  Если нужно «n штук, где n известно только во время работы», или
//  объект должен пережить функцию, которая его создала, — нужна КУЧА.
//
//  Как и в C, память в C3 управляется вручную: что выделили — то
//  обязаны освободить. Сборщика мусора нет.
//
//  --- Низкий уровень: malloc / free --------------------------------
//
//      int* p = malloc(int::size * 4);   // 4 int'а, память НЕ обнулена
//      p[0] = 1;
//      free(p);
//
//  `malloc` и `free` — встроенные (@builtin) функции, их можно звать без
//  префикса модуля. `malloc` возвращает `void*`, а `void*` в C3 неявно
//  приводится к любому указателю — каст не нужен. Размер типа берём через
//  `int::size` (а не sizeof(int), как в C).
//
//  --- Удобный уровень: mem::new и mem::new_array -------------------
//
//  Считать байты руками утомительно и опасно. Стандартная библиотека
//  предлагает макросы, которые знают тип:
//
//      Foo* f   = mem::new(Foo);                // один Foo, обнулённый
//      Foo* g   = mem::new(Foo, { .x = 1 });    // ...и сразу инициализированный
//      int[] xs = mem::new_array(int, n);       // СРЕЗ из n обнулённых int'ов
//
//  Обратите внимание: `new_array` возвращает не указатель, а срез —
//  у него есть `.len`, по нему работает `foreach`, проверка границ и т.д.
//  Освобождается срез тем же `free(xs)` (free берёт его указатель).
//
//  Есть и «необнулённые» варианты: `mem::alloc(Foo)`, `mem::alloc_array(int, n)`
//  — чуть быстрее, но там мусор, пока вы сами всё не заполните.
//
//  --- defer free -----------------------------------------------------
//
//  Самый надёжный способ не забыть освободить память — написать `free`
//  сразу после выделения, но через `defer`:
//
//      int[] xs = mem::new_array(int, n);
//      defer free(xs);        // выполнится при выходе из области видимости
//
//  Так выделение и освобождение стоят рядом, и никакой ранний `return`
//  не приведёт к утечке.
//
//  --- @assert_leak ---------------------------------------------------
//
//  В этом упражнении код обёрнут в `@assert_leak() { ... };`. Это макрос
//  из stdlib: на время блока он подменяет кучу на «следящий» аллокатор и,
//  если к концу блока остались неосвобождённые байты, печатает отчёт и
//  аварийно завершает программу. Отличный инструмент для поиска утечек
//  (работает в safe-режиме, который включён по умолчанию).
//
//  ЗАДАЧА:
//    1. Выделите узел списка через `mem::new` с инициализатором.
//    2. Выделите массив квадратов через `mem::new_array`.
//    3. Устраните утечку — освободите массив квадратов.
//  Программа должна напечатать:
//      list: 3 2 1
//      squares: 0 1 4 9 16
//      no leaks
//
import std::io;

struct Node
{
    int value;
    Node* next;
}

// Добавляет новый узел в начало списка и возвращает новую голову.
fn Node* push_front(Node* head, int value)
{
    Node* n = ???;   // TODO: mem::new(...) с инициализатором
    return n;
}

fn void free_list(Node* head)
{
    while (head)
    {
        Node* next = head.next;
        free(head);
        head = next;
    }
}

fn void main()
{
    @assert_leak()
    {
        // --- связный список на куче ---
        Node* list = null;
        for (int i = 1; i <= 3; i++) list = push_front(list, i);
        defer free_list(list);

        io::print("list:");
        for (Node* n = list; n; n = n.next) io::printf(" %d", n.value);
        io::printn();

        // --- массив, размер которого известен только во время работы ---
        int count = 5;
        int[] squares = ???;   // TODO: срез из count обнулённых int'ов
        // TODO: не забудьте освободить squares
        assert(squares.len == 5);
        foreach (i, &sq : squares) *sq = (int)(i * i);

        io::print("squares:");
        foreach (sq : squares) io::printf(" %d", sq);
        io::printn();

        // --- голый malloc: тоже можно, но размер считаем сами ---
        int* raw = malloc(int::size * 2);
        raw[0] = 40;
        raw[1] = 2;
        assert(raw[0] + raw[1] == 42);
        free(raw);
    };
    io::printn("no leaks");
}
