// ---------------------------------------------------------------- проверка

uint seed = 2024;
fn uint next_rand()
{
    seed = seed * 1664525 + 1013904223;
    return seed >> 8;
}

fn void main()
{
    // Длины специально не кратны ширине векторов — проверяем хвосты.
    sz[*] sizes = { 0, 1, 7, 8, 15, 16, 17, 100, 1003 };
    float checksum = 0;
    sz total_hits = 0;
    foreach (n : sizes)
    {
        float[] a = mem::new_array(float, n);
        float[] b = mem::new_array(float, n);
        char[] px1 = mem::new_array(char, n);
        char[] px2 = mem::new_array(char, n);
        float[] r1 = mem::new_array(float, n);
        float[] r2 = mem::new_array(float, n);
        defer { free(a); free(b); free(px1); free(px2); free(r1); free(r2); }

        for (sz i = 0; i < n; i++)
        {
            // небольшие целые значения: любая перестановка сложений даёт точно тот же float
            a[i] = (float)((int)(next_rand() % 21) - 10);
            b[i] = (float)((int)(next_rand() % 21) - 10);
            px1[i] = px2[i] = (char)(next_rand() % 256);
            r1[i] = r2[i] = (float)((int)(next_rand() % 9) - 4);
        }
        float d1 = dot_scalar(a, b);
        float d2 = dot_simd(a, b);
        assert(d1 == d2, "dot n=%d: %f vs %f", n, d1, d2);

        saturating_add_scalar(px1, 100);
        saturating_add(px2, 100);
        assert(px1 == px2, "saturating_add n=%d differs", n);

        sz c1 = count_byte_scalar(px1, 255);
        sz c2 = count_byte(px2, 255);
        assert(c1 == c2, "count_byte n=%d: %d vs %d", n, c1, c2);

        relu_scale_scalar(r1, 1.5f);
        relu_scale(r2, 1.5f);
        assert(r1 == r2, "relu_scale n=%d differs", n);

        checksum += d2;
        total_hits += c2;
        io::printfn("n=%4d dot=%8.1f saturated=%4d", n, d2, c2);
    }
    // Нетривиальность: на пустом массиве и векторный код должен работать.
    assert(dot_simd({}, {}) == 0);
    io::printfn("checksum=%.1f hits=%d", checksum, total_hits);
    io::printn("SIMD results match scalar reference");
}
