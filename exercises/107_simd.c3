// =====================================================================
//  107 · SIMD на практике
// =====================================================================
//
//  SIMD (Single Instruction, Multiple Data) — одна инструкция обрабатывает
//  сразу 4/8/16/... значений. SSE даёт 128-битные регистры, AVX2 — 256,
//  AVX-512 и SVE — ещё шире, NEON на ARM — 128. Для кода, который упирается
//  в арифметику над массивами (обработка изображений, аудио, физика,
//  поиск байтов в парсерах вроде simdjson), это ускорение в разы.
//
//  ТРИ СПОСОБА ПОЛУЧИТЬ SIMD
//  -------------------------
//  1. Автовекторизация. Компилятор сам превращает простой цикл в
//     векторный. Хрупко: мешают алиасинг указателей, ветвления, вызовы
//     функций и — важно! — float-редукции. Сложение float не ассоциативно:
//     (a+b)+c != a+(b+c) в общем случае, поэтому компилятор НЕ имеет права
//     переставить `sum += a[i]` в 8 параллельных частичных сумм без
//     -ffast-math. Цикл скалярного dot product остаётся скалярным.
//  2. Интринсики (_mm256_add_ps...). Полный контроль, но привязка к
//     конкретной архитектуре и нечитаемый код.
//  3. Переносимые векторные типы — путь C3 (как GCC vector extensions,
//     Rust std::simd, Zig @Vector). LLVM сам выберет инструкции под цель.
//
//  ВЕКТОРЫ В C3
//  ------------
//      float[<8>] v = a[i:8];       // загрузка 8 элементов из среза
//      float[<8>] k = 2.0f;         // скаляр «размножается» во все дорожки (splat)
//      v = v * k + 1.0f;            // арифметика — по дорожкам
//      float s = v.sum();           // горизонтальная редукция
//      char[8] tmp = (char[8])...;  // вектор -> массив, затем
//      dst[i:8] = tmp[..];          // запись обратно в срез
//
//  Сравнения. ОСТОРОЖНО: `a == b` для векторов сравнивает их ЦЕЛИКОМ и
//  даёт один `bool` (даже `bool[<8>] m = a == b;` лишь размножит этот
//  один bool!). Поэлементные маски `bool[<N>]` дают методы
//  `a.comp_eq(b)`, `a.comp_lt(b)`, `a.comp_gt(b)` и т.д. (import std::math).
//  Маска используется в `math::select(mask, a, b)` — безветвенный выбор
//  по дорожкам (это blend/vpblendvb), или сворачивается в битовую маску
//  `mask.mask_to_int()` (это movemask), на которой работают popcount/ctz.
//  Поэлементные min/max: `math::min(a, b)`, `math::max(a, b)`
//  (а `v.max()` — это горизонтальный максимум!). Приведение
//  `(ushort[<16>])bytes` расширяет каждую дорожку, обратное — сужает.
//
//  ТИПИЧНЫЕ ПРИЁМЫ
//  ---------------
//  * Основной цикл по блокам ширины W + скалярный «хвост» для
//    оставшихся len % W элементов. Забыть хвост — классический баг.
//  * Несколько независимых аккумуляторов скрывают латентность сложения
//    (каждый векторный аккумулятор — уже 8 частичных сумм).
//  * Ветвления заменяются масками: вычислить обе ветви и выбрать select'ом.
//  * Насыщающая арифметика для пикселей: расширить до 16 бит, сложить,
//    обрезать min'ом до 255, сузить обратно (на x86 есть и прямые
//    paddusb — LLVM часто распознаёт именно такой шаблон).
//  * Поиск байта: сравнить 16/32 байт с образцом, movemask, popcount/ctz.
//    Так memchr, strlen и simdjson обрабатывают десятки байт за такт.
//
//  ПОДВОДНЫЕ КАМНИ
//  ---------------
//  * Векторный float-результат может отличаться от скалярного в последних
//    битах (другой порядок сложений). В тестах сравнивайте с допуском или,
//    как здесь, используйте целые значения, где порядок не важен.
//  * Выравнивание. В C3 0.8.5 `float[<8>]::alignment` равно 4 (как у
//    элемента), так что загрузка `a[i:8]` из любого места среза
//    корректна. Но невыровненные по 32/64 байта загрузки могут
//    пересекать кеш-линии и быть медленнее — горячие буферы в движках
//    выделяют с выравниванием по кеш-линии (см. упражнение 124).
//  * Замеры времени не печатаем — они недетерминированы. Попробуйте сами
//    с `-O3` и `time`, будет видно разницу в 4–8 раз.
//
//  ЗАДАЧА: реализуйте четыре функции, помеченные TODO, используя
//  векторные типы (основной цикл по блокам + скалярный хвост). Скалярные
//  эталоны даны — результат должен совпасть точно.
//
import std::io, std::math;

const sz FW = 8;    // ширина float-вектора
const sz BW = 16;   // ширина байтового вектора

// ---------------------------------------------------------------- эталоны

fn float dot_scalar(float[] a, float[] b)
{
    float s = 0;
    foreach (i, x : a) s += x * b[i];
    return s;
}

fn void saturating_add_scalar(char[] px, char add)
{
    foreach (&p : px) *p = (int)*p + add > 255 ? 255 : *p + add;
}

fn sz count_byte_scalar(char[] s, char c)
{
    sz n = 0;
    foreach (ch : s) if (ch == c) n++;
    return n;
}

fn void relu_scale_scalar(float[] xs, float k)
{
    foreach (&x : xs) *x = *x > 0 ? *x * k : 0;
}

// ---------------------------------------------------------------- SIMD

fn float dot_simd(float[] a, float[] b)
{
    assert(a.len == b.len);
    // TODO: аккумулятор float[<FW>], цикл по блокам a[i:FW]/b[i:FW],
    //       в конце .sum() и скалярный хвост.
    return 0;
}

