// =====================================================================
//  076 · Макросы: основы
// =====================================================================
//
//  Макросы в C — это текстовая подстановка препроцессора:
//
//      #define SQUARE(x) x * x
//      SQUARE(1 + 2)      // -> 1 + 2 * 1 + 2 == 5, а не 9!
//      SQUARE(next())     // next() вызовется ДВАЖДЫ
//
//  Отсюда скобки вокруг всего подряд, `do { ... } while (0)`, конфликты
//  имён и полное отсутствие типов. Макросы C3 работают совсем иначе:
//  это не текст, а КОД, который встраивается (inline) в место вызова
//  на уровне синтаксического дерева, с проверкой типов.
//
//      macro square(x)
//      {
//          return x * x;
//      }
//      // или короче:
//      macro square(x) => x * x;
//
//  Свойства обычного (function-like) макроса:
//
//    * Параметры без типа (`x`) принимают значение ЛЮБОГО типа: `square(3)`
//      вернёт int, `square(1.5)` — double. Это «утиная типизация»: код
//      проверяется после подстановки, и если `*` для типа не определён —
//      будет понятная ошибка компиляции.
//    * Аргументы вычисляются РОВНО ОДИН РАЗ, до входа в макрос, как у
//      функции: `square(next())` вызывает `next()` один раз,
//      `square(1 + 2)` == 9. Никаких лишних скобок не нужно.
//    * Тип возвращаемого значения выводится сам, но должен быть
//      однозначным: все `return` обязаны вернуть один и тот же тип.
//      Можно указать его явно: `macro int twice(int x) => x * 2;`
//      Параметрам тоже можно задать тип — тогда аргумент к нему
//      приводится, как у функции.
//    * Гигиена: локальные переменные макроса не пересекаются с
//      переменными вызывающего кода. Если внутри макроса есть `var m`,
//      а у вас снаружи тоже `m` — ничего не сломается.
//    * Внутри макроса можно объявлять переменные через `var` (тип
//      выводится). В обычных функциях `var` для рантайм-переменных
//      запрещён (только с `@safeinfer`), а в макросах — пожалуйста,
//      ведь тип аргумента заранее неизвестен.
//    * Макрос — не функция: у него нет адреса (`&square` нельзя), его
//      нельзя передать как колбэк. Каждый вызов — новая копия кода.
//    * Макросы могут вызывать другие макросы и самих себя (глубина
//      рекурсии ограничена).
//
//  Макрос vs generic-функция. `square` можно написать и как
//  `fn Type square(Type x) <Type>`. Разница: generic-функция — это
//  настоящая функция (есть адрес, одна копия на тип, вызывается
//  `square{int}(3)`), а макрос встраивается в каждое место вызова и
//  не требует указывать тип. Правило: простые операции «для любого
//  типа» — макросы (как `max`, `min`, `abs` в std::math), сложная
//  логика и типы данных — generics.
//
//  Имя такого макроса пишется как обычная функция, без `@`. Знак `@` в
//  имени обязателен только для «опасных» макросов с особыми
//  возможностями — о них в следующих упражнениях.
//
//  ЗАДАЧА: реализуйте макросы `square`, `max3` (максимум из трёх) и
//  `clamp` (ограничить x отрезком [lo, hi]). Каждый должен работать и
//  с int, и с double.
//
import std::io;

macro square(x) => x; // TODO

macro max3(a, b, c)
{
    // TODO: верните наибольший из a, b, c.
    return a;
}

macro clamp(x, lo, hi)
{
    // TODO: ограничьте x отрезком [lo, hi].
    return x;
}

macro int twice(int x) => x * 2;

int calls;
fn int next()
{
    calls++;
    return calls * 10;
}

fn void main()
{
    assert(square(5) == 25);
    assert(square(1 + 2) == 9);
    io::printfn("square(1 + 2) = %d", square(1 + 2));
    io::printfn("square(1.5)   = %.2f", square(1.5));

    int r = square(next());
    assert(calls == 1, "argument must be evaluated once");
    io::printfn("square(next()) = %d, next() called %d time(s)", r, calls);

    assert(max3(3, 9, 4) == 9);
    assert(max3(10, 2, 3) == 10);
    assert(max3(1, 2, 30) == 30);
    io::printfn("max3(3, 9, 4) = %d", max3(3, 9, 4));
    io::printfn("max3(-1.5, -0.5, -2.0) = %.1f", max3(-1.5, -0.5, -2.0));

    assert(clamp(15, 0, 10) == 10);
    assert(clamp(-5, 0, 10) == 0);
    assert(clamp(7, 0, 10) == 7);
    io::printfn("clamp(0.75, 0.0, 0.5) = %.2f", clamp(0.75, 0.0, 0.5));

    // Гигиена: у макроса max3 внутри тоже есть `m`, но это не наша `m`.
    int m = 100;
    int big = max3(m, 1, 2);
    io::printfn("m = %d, big = %d", m, big);

    io::printfn("twice(21) = %d", twice(21));
    io::printfn("type of square(2.0f): %s", $Typeof(square(2.0f))::name);
}
