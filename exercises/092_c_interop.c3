// =====================================================================
//  092 · Взаимодействие с C: extern fn, @cname, колбэки
// =====================================================================
//
//  C3 совместим с C на уровне ABI: те же соглашения о вызовах, та же
//  раскладка структур, те же имена символов. Поэтому вызвать функцию
//  из libc (или любой C-библиотеки) можно без всяких «биндингов» и
//  генераторов кода — достаточно объявить её прототип с `extern`:
//
//      // C:  int atoi(const char* s);
//      extern fn CInt atoi(ZString s);
//
//  Тело не пишется — компоновщик найдёт символ `atoi` в libc (она
//  подключается по умолчанию; другие библиотеки — флагом `-l имя`).
//
//  Перевод типов C -> C3:
//      int            -> CInt   (а НЕ int: в C3 `int` всегда 32 бита,
//                                в C — «как получится»)
//      long           -> CLong  (на Linux x86-64 — 64 бита, на Windows — 32!)
//      size_t         -> usz
//      char*          -> char*  или ZString (char*, завершённый нулём)
//      const T*       -> T*     (в C3 нет квалификатора const)
//      void (*f)(int) -> alias Fn = fn void(CInt);
//      T arr[]        -> T*     (массивы C3 не «распадаются» в указатели)
//
//  Строки. String в C3 — это срез (указатель + длина), НЕ нуль-
//  терминированный. В C-функции его передавать нельзя. Строковые
//  литералы C3 неявно приводятся к ZString (компилятор кладёт в конец
//  '\0'). Для произвольной String есть `s.zstr_tcopy()` (копия во
//  временной памяти) и `s.zstr_copy(mem)`, а обратно —
//  `zs.str_view()`.
//
//  Другое имя. Если хочется называть функцию в C3 иначе, чем символ в
//  библиотеке (например, чтобы не конфликтовать), используйте @cname:
//
//      extern fn usz c_strlen(ZString s) @cname("strlen");
//
//  В обратную сторону: чтобы C-код мог позвать функцию C3, пометьте её
//  `@export("имя")`. Без явного имени экспортируемый символ получит
//  префикс модуля (`mymod__foo`), что из C неудобно.
//
//  Колбэки. Многие C-API принимают указатель на функцию. Обычная
//  функция C3 с подходящей сигнатурой — это и есть C-функция, её адрес
//  `&my_cmp` можно отдать в C. Лямбда без захвата тоже подходит:
//
//      alias CompareFn = fn CInt(void* a, void* b);
//      extern fn void qsort(void* base, usz count, usz size, CompareFn cmp);
//
//  Подводные камни:
//    * сигнатура extern fn — это ваше честное слово. Компилятор НЕ
//      проверяет её по заголовку C. Ошиблись в типе (int вместо CLong,
//      забыли аргумент) — получите мусор или падение во время работы;
//    * колбэк вызывается из C-кода, внутри которого нет C3-шных проверок;
//      паника внутри колбэка «пролетит» через C-фреймы;
//    * компаратор qsort должен задавать строгий порядок и возвращать
//      <0, 0, >0. Классическая ошибка — `return a - b;`, которая
//      переполняется на больших числах. Пишите сравнения явно.
//
//  Для сравнения: в Zig есть @cImport, который сам читает .h-файлы;
//  в Rust — extern "C" блоки и bindgen. В C3 прототипы пишутся вручную,
//  но это одна строка на функцию.
//
//  ЗАДАЧА:
//    1. Допишите @cname так, чтобы c_strlen вызывала C-функцию strlen.
//    2. Объявите qsort (прототип C: см. TODO ниже).
//    3. Допишите компаратор: игроки по убыванию score, при равенстве
//       score — по возрастанию id.
//
//  Ожидаемый вывод:
//      strlen("interop") = 7
//      atoi("1234") + 1 = 1235
//      id=4 score=90
//      id=2 score=75
//      id=5 score=75
//      id=1 score=60
//      id=3 score=10
//
import std::io;

struct Player
{
    int id;
    int score;
}

alias CompareFn = fn CInt(void* a, void* b);

extern fn CInt atoi(ZString s);
extern fn usz c_strlen(ZString s) @cname(???);

// TODO: объявите qsort из libc. Прототип в C:
//   void qsort(void* base, size_t count, size_t size,
//              int (*compar)(const void*, const void*));


fn CInt compare_players(void* a, void* b)
{
    Player* pa = (Player*)a;
    Player* pb = (Player*)b;
    // TODO: по убыванию score, при равенстве — по возрастанию id.
    //       Верните -1, 0 или 1.
    return 0;
}

fn void main()
{
    io::printfn("strlen(\"interop\") = %d", c_strlen("interop"));
    io::printfn("atoi(\"1234\") + 1 = %d", atoi("1234") + 1);

    Player[5] players = {
        { 1, 60 }, { 2, 75 }, { 3, 10 }, { 4, 90 }, { 5, 75 },
    };
    qsort(&players, players.len, Player::size, &compare_players);
    foreach (p : players) io::printfn("id=%d score=%d", p.id, p.score);
}
