// =====================================================================
//  045 · Составные литералы, адрес временного значения, копирование
// =====================================================================
//
//  СОСТАВНОЙ ЛИТЕРАЛ — значение структуры или массива прямо в
//  выражении, без отдельной переменной (как в C99):
//
//      draw((Vec){ 3, 4 });
//      int[3] a = (int[3]){ 1, 2, 3 };
//
//  Если тип понятен из контекста (параметр функции, присваивание),
//  его можно опустить — так и принято писать:
//
//      draw({ 3, 4 });
//      v = { .y = 9 };     // ВНИМАНИЕ: все неуказанные поля обнулятся!
//
//  Поля можно взять из другой структуры и часть переопределить
//  («splat» `...`):
//
//      Config debug = { ...release, .verbose = true };
//
//  АДРЕС ВРЕМЕННОГО ЗНАЧЕНИЯ. В C нельзя взять адрес литерала:
//  `&5` — ошибка, приходится заводить переменную. В C3 для этого есть
//  отдельный оператор `&&`:
//
//      set_value(&&5);                       // int*, указывающий на 5
//      int s = sum(&&(int[3]){ 1, 2, 3 }, 3);
//
//  Такой указатель живёт только до конца текущей функции — никогда
//  не возвращайте его наружу. Обычный `&` к временному значению
//  применить нельзя — компилятор подскажет `&&`.
//
//  КОПИРОВАНИЕ. Структуры, как и массивы (019), — это ЗНАЧЕНИЯ:
//
//      Squad b = a;        // копируются ВСЕ байты структуры
//
//  * Массив фиксированного размера внутри структуры копируется
//    целиком — у b будет свой собственный массив.
//  * Указатель (и срез, и String!) копируется как адрес — обе копии
//    смотрят на ОДНИ И ТЕ ЖЕ данные.
//  * Передача структуры в функцию по значению тоже делает копию:
//    изменения внутри функции до вызывающего не дойдут. Чтобы менять
//    оригинал, передавайте указатель.
//  * Сравнивать структуры через `==` нельзя (компилятор не знает,
//    что для вас «равно»), сравнивайте поля.
//
//  ЗАДАЧА: почините четыре места, помеченные `// <-`. В двух из них
//  нужно предсказать результат копирования.
//
import std::io;

struct Team
{
    String name;
    int[3] scores;
    int* bonus;
}

fn int sum(int* values, usz n)
{
    int total;
    for (usz i = 0; i < n; i++) total += values[i];
    return total;
}

fn void reset_scores(Team t) // <- изменения должны дойти до вызывающего
{
    t.scores = { 0, 0, 0 };
}

fn void main()
{
    int s = sum(&(int[3]){ 4, 5, 6 }, 3); // <- адрес временного массива
    io::printfn("sum = %d", s);

    int shared_bonus = 1;
    Team red = { "red", { 10, 20, 30 }, &shared_bonus };

    Team copy = red;
    copy.scores[0] = 99;
    *copy.bonus = 5;
    io::printfn("red: %s bonus=%d", red.scores, *red.bonus);
    assert(red.scores[0] == ???); // <- массив внутри структуры копируется?
    assert(*red.bonus == ???);     // <- а данные по указателю?

    Team blue = { ...red, .name = "blue" };
    reset_scores(blue);
    io::printfn("%s: %s, %s: %s", red.name, red.scores, blue.name, blue.scores);
    assert(sum(&blue.scores, 3) == 0);
}
