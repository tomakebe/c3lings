// =====================================================================
//  052 · Временный аллокатор: @pool, tmem, tformat
// =====================================================================
//
//  Ручной `free` для каждой мелочи — утомительно. Большая часть
//  выделений в программе живёт очень недолго: собрать строку, чтобы
//  напечатать; построить промежуточный массив, чтобы посчитать сумму...
//  Для таких случаев в C3 есть ВРЕМЕННЫЙ аллокатор — `tmem`.
//
//  Устроен он как арена (bump allocator): выделение — это просто сдвиг
//  указателя, освобождать по одному объекту не нужно (и нельзя).
//  Вся временная память освобождается разом при выходе из `@pool`:
//
//      @pool()
//      {
//          String s = string::tformat("x = %d", 42);  // память из tmem
//          int[] tmp = mem::temp_array(int, 100);      // тоже tmem
//          ...
//      };   // <- здесь всё, что выделено через tmem внутри, исчезает
//
//  Обратите внимание на `;` после закрывающей скобки: `@pool` — это
//  макрос с «хвостовым блоком», а вызов макроса — инструкция.
//
//  Соглашение об именах в stdlib: функции с префиксом `t` (или `temp_`)
//  выделяют память во временном аллокаторе:
//      string::tformat(...)     вместо string::format(mem, ...)
//      mem::tnew(Foo)           вместо mem::new(Foo)
//      mem::temp_array(int, n)  вместо mem::new_array(int, n)
//      s.tcopy()                вместо s.copy(mem)
//
//  Пулы вкладываются: внутренний `@pool` освобождает только то, что
//  выделено внутри него. Даже в `main` без явного `@pool` временный
//  аллокатор работает (там есть пул «верхнего уровня»), но в длинных
//  циклах без `@pool` временная память будет только расти.
//
//  ГЛАВНАЯ ЛОВУШКА: временные данные нельзя использовать после выхода
//  из их `@pool`. В safe-режиме освобождённая временная память
//  затирается байтами 0xAA — поэтому вместо строки вы увидите мусор.
//  Если результат нужен дольше — скопируйте его в долгоживущую память:
//
//      String keep = tmp_string.copy(mem);   // теперь это ваша куча
//      ...
//      free(keep);
//
//  ЗАДАЧА:
//    1. В `label` соберите строку временным форматированием (`tformat`).
//    2. Строка `favorite` используется после `@pool` — сохраните в неё
//       копию в куче, а не саму временную строку.
//    3. Не забудьте освободить эту копию (иначе @assert_leak упадёт).
//  Ожидаемый вывод:
//      item-1: 1
//      item-2: 4
//      item-3: 9
//      item-4: 16
//      favorite: item-3: 9
//
import std::io;

// Возвращает ВРЕМЕННУЮ строку: она живёт до конца текущего @pool.
fn String label(int i)
{
    return string::???("item-%d: %d", i, i * i);
}

fn void main()
{
    @assert_leak()
    {
        String favorite;   // понадобится ПОСЛЕ цикла
        // TODO: освободите favorite, когда она станет не нужна

        for (int i = 1; i <= 4; i++)
        {
            @pool()
            {
                String s = label(i);
                io::printn(s);
                if (i == 3) favorite = s;   // <- s умрёт вместе с этим @pool...
            };
        }
        io::printfn("favorite: %s", favorite);
    };
}
