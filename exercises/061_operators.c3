// =====================================================================
//  061 · Перегрузка арифметических операторов
// =====================================================================
//
//  Для «числовых» пользовательских типов — векторов, комплексных чисел,
//  денег, матриц — удобно писать `a + b` вместо `a.add(b)`. В C3 оператор
//  перегружается обычным методом с атрибутом `@operator(...)`:
//
//      fn Vec2 Vec2.add(self, Vec2 o) @operator(+) => { self.x + o.x, self.y + o.y };
//      fn Vec2 Vec2.sub(self, Vec2 o) @operator(-) => { self.x - o.x, self.y - o.y };
//
//  Имя метода любое (`add`, `plus`...) — его по-прежнему можно вызвать
//  явно: `a.add(b)`. Атрибут лишь связывает метод с оператором.
//
//  Доступны: + - * / %, унарные - и +, ^ | & << >>.
//    * Унарный минус — метод БЕЗ второго параметра с `@operator(-)`:
//          fn Vec2 Vec2.neg(self) @operator(-) => { -self.x, -self.y };
//    * Составные `+=`, `-=`... появляются автоматически из `+`, `-`
//      (при желании их можно перегрузить отдельно ради скорости).
//    * Смешанные типы: `Vec2 * int` — это `@operator(*)` с параметром
//      int. Но `int * Vec2` такой метод не покрывает: левый операнд —
//      не Vec2. Для этого есть:
//          @operator_s(*)  — «симметричный»: работает в обе стороны;
//          @operator_r(-)  — «обратный»: только `значение - Vec2`.
//    * Перегрузки можно различать по типу второго операнда
//      (Vec2 * int и Vec2 * Vec2 — разные методы).
//
//  Ограничения (в отличие от C++): перегружать можно только для своих
//  типов, нельзя перегрузить `&&`, `||`, `=`, вызов функции, и нельзя
//  придумать новый оператор. И правило хорошего тона: `+` должен
//  складывать, а не «добавлять в список» или «печатать».
//
//  ЗАДАЧА: подключите методы к операторам так, чтобы main
//  скомпилировалась. Ожидаемый вывод:
//      a + b = (11, 22)
//      b - a = (9, 18)
//      -a = (-1, -2)
//      a * 3 = (3, 6)
//      2 * b = (20, 40)
//      pos = (6, 12)
//
import std::io;

struct Vec2
{
    int x, y;
}

fn Vec2 Vec2.add(self, Vec2 o) => { self.x + o.x, self.y + o.y };
fn Vec2 Vec2.sub(self, Vec2 o) @operator(-) => { self.x - o.x, self.y - o.y };
// TODO: унарный минус
fn Vec2 Vec2.scale(self, int k) @operator(*) => { self.x * k, self.y * k };

fn void show(String label, Vec2 v) => io::printfn("%s = (%d, %d)", label, v.x, v.y);

fn void main()
{
    Vec2 a = { 1, 2 };
    Vec2 b = { 10, 20 };

    show("a + b", a + b);
    show("b - a", b - a);
    show("-a", -a);
    show("a * 3", a * 3);
    show("2 * b", 2 * b);

    Vec2 pos;
    Vec2 velocity = { 2, 4 };
    for (int i = 0; i < 3; i++) pos += velocity;   // += бесплатно из +
    show("pos", pos);
    assert(pos.x == a.add(a).x * 3);
}
