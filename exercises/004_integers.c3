// =====================================================================
//  004 · Целые числа
// =====================================================================
//
//  В C размер `int` и `long` зависит от платформы. В C3 у целых типов
//  ФИКСИРОВАННЫЙ размер на любой платформе:
//
//      знаковые      беззнаковые     бит
//      ichar         char              8
//      short         ushort           16
//      int           uint             32
//      long          ulong            64
//      int128        uint128         128
//
//  Обратите внимание: `char` в C3 — БЕЗзнаковый байт (0..255), а
//  знаковый байт называется `ichar`. В C знаковость `char` зависела
//  от компилятора.
//
//  Есть ещё два типа «размером с указатель» (64 бита на 64-битной
//  платформе): `usz` — беззнаковый размер (как `size_t`), им измеряются
//  длины массивов; `sz` — его знаковый вариант (как `ptrdiff_t`).
//
//  Свойства типа доступны через `::` :
//      int::size   — размер в байтах (4)
//      int::max    — наибольшее значение
//      int::min    — наименьшее значение
//
//  ЛИТЕРАЛЫ
//      1_000_000       подчёркивания для читаемости (игнорируются)
//      0xFF            шестнадцатеричный
//      0b1010          двоичный (в C его долго не было)
//      0o755           восьмеричный — ОБРАТИТЕ ВНИМАНИЕ на `0o`!
//      10u, 10L, 10UL  суффиксы: uint, long, ulong (`ll`/`ull` — 128 бит)
//
//  ЛОВУШКА ДЛЯ ПРОГРАММИСТА НА C: в C запись `0755` означает
//  восьмеричное число 493. В C3 такая форма удалена, и ведущий ноль
//  просто ничего не значит: `0755` == 755 (десятичное!). Для
//  восьмеричных чисел всегда пишите `0o755`.
//
//  Десятичный литерал по умолчанию имеет тип `int`. Если число не
//  помещается в тип переменной, компилятор откажется молча обрезать
//  его: "The value ... is out of range for 'int'". Выберите тип пошире.
//
//  ЗАДАЧА: исправьте три места, отмеченные `// <-`. Программа должна
//  напечатать:
//
//      sizes: 1 2 4 8 16
//      byte range: 0..255, ichar range: -128..127
//      population: 8100000000
//      perms: 493
//      flags: 10
//
import std::io;

fn void main()
{
    io::printfn("sizes: %d %d %d %d %d",
                char::size, short::size, int::size, long::size, int128::size);
    io::printfn("byte range: %d..%d, ichar range: %d..%d",
                char::min, char::max, ichar::min, ichar::max);

    int population = 8_100_000_000;       // <- не помещается в int
    io::printfn("population: %d", population);

    int perms = 0755;                     // <- задумывалось восьмеричное 755
    assert(perms == 493);
    io::printfn("perms: %d", perms);

    uint flags = 0b0000_1010;
    assert(flags == ???);                 // <- чему это равно в десятичной?
    io::printfn("flags: %d", flags);
}
