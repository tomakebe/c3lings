// =====================================================================
//  024 · Структуры
// =====================================================================
//
//  ОБЪЯВЛЕНИЕ
//
//      struct Vec2
//      {
//          int x;
//          int y;
//      }
//
//  В отличие от C:
//  * после `}` точка с запятой не нужна;
//  * `typedef struct ... Vec2;` не нужен — имя `Vec2` сразу является
//    типом, писать `struct Vec2 v;` при использовании не надо;
//  * имя типа начинается с заглавной буквы, но НЕ может быть целиком
//    заглавным: `Vec2` — да, `VEC2` или `P` — ошибка ("Names of structs
//    cannot be all uppercase"). Всё заглавное зарезервировано для
//    констант.
//
//  ИНИЦИАЛИЗАЦИЯ
//      Vec2 a = { 1, 2 };              // позиционная: по порядку полей
//      Vec2 b = { .y = 5, .x = 3 };    // именованная (designated)
//      Vec2 c = { .x = 7 };            // y = 0 (всё неуказанное — нули)
//      Vec2 d;                         // { 0, 0 }
//
//  Позиционная форма зависит от порядка полей: переставили поля в
//  объявлении — и все такие инициализаторы поменяли смысл (или перестали
//  компилироваться). Для структур с несколькими полями именованная форма
//  надёжнее.
//
//  ВЛОЖЕННЫЕ СТРУКТУРЫ инициализируются вложенными скобками, а в
//  именованной форме можно сразу обратиться к полю вложенной:
//
//      Player p = { .name = "Ann", .pos = { 1, 2 } };
//      Player q = { .name = "Bob", .pos.x = 4 };
//
//  Доступ к полям — через точку: `p.pos.x`.
//
//  СТРУКТУРА — ЭТО ЗНАЧЕНИЕ. Присваивание и передача в функцию
//  копируют её целиком. Оператора `==` для структур по умолчанию нет
//  (сравнивайте поля или перегрузите оператор — упражнение 063).
//  А `%s` для структуры печатает не поля, так что печатаем поля вручную.
//
//  ЗАДАЧА: исправьте три места с `// <-`. Программа должна напечатать:
//
//      Ann: hp=100 at (3, 4)
//      Bob: hp=80 at (0, 7)
//      copy: hp=100, original: hp=90
//
import std::io;

struct Vec2
{
    int x;
    int y;
}

struct HERO                                    // <- такое имя типа запрещено
{
    String name;
    int hp;
    Vec2 pos;
}

fn void describe(Hero h)
{
    io::printfn("%s: hp=%d at (%d, %d)", h.name, h.hp, h.pos.x, h.pos.y);
}

fn void main()
{
    Hero ann = { 100, "Ann", { 3, 4 } };       // <- порядок не совпадает с полями
    describe(ann);

    Hero bob = { .name = "Bob", .hp = 80, ??? };   // <- y = 7, x по умолчанию
    describe(bob);

    Hero copy = ann;
    ann.hp -= 10;
    io::printfn("copy: hp=%d, original: hp=%d", copy.hp, ann.hp);
}
