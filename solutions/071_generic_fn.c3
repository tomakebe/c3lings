// =====================================================================
//  071 · Generic-функции
// =====================================================================
//
//  Добро пожаловать в Часть III! Начинаем с обобщённого (generic)
//  программирования: как написать функцию один раз, а использовать её
//  с разными типами.
//
//  Как это делают в других языках:
//
//    * C:   либо макрос препроцессора `#define MAX(a, b) ((a) > (b) ? (a) : (b))`
//           (никаких типов, двойное вычисление аргументов, ужасные ошибки),
//           либо `void*` + размер элемента, как в `qsort` (без проверки типов).
//    * C++: шаблоны `template <typename T> T max(T a, T b)`. Типы выводятся
//           из аргументов, есть перегрузка, SFINAE, специализации... мощно,
//           но сообщения об ошибках бывают на три экрана.
//    * Zig: тип — обычный параметр времени компиляции:
//           `fn max(comptime T: type, a: T, b: T) T`.
//
//  В C3 generic-параметры пишутся в угловых скобках ПОСЛЕ списка
//  аргументов функции:
//
//      fn Type my_max(Type a, Type b) <Type>
//      {
//          return a > b ? a : b;
//      }
//
//  `Type` здесь — имя параметра-типа. Внутри функции оно ведёт себя как
//  обычное имя типа (как будто написали `alias Type = int;`).
//
//  Вызов — ТОЛЬКО с явным указанием параметров в фигурных скобках:
//
//      int    a = my_max{int}(3, 7);        // 7
//      double b = my_max{double}(1.5, -2.0); // 1.5
//
//  Вывода типов из аргументов, как в C++, НЕТ. Это сознательное решение:
//  читая `my_max{int}(...)`, вы всегда точно знаете, какая версия будет
//  вызвана, и нет никакой «магии перегрузки». Если забыть `{int}`,
//  компилятор скажет: "'my_max' is a generic function, did you forget
//  the parameters '{ ... }'?"
//
//  Чтобы не писать `{int}` каждый раз, создают псевдоним конкретной версии
//  (инстанцирования) через уже знакомый `alias`:
//
//      alias max_int = my_max{int};
//      max_int(10, 2);    // 10
//
//  Как это работает. Для каждого набора параметров компилятор создаёт
//  отдельную копию функции (мономорфизация, как в C++/Rust/Zig):
//  `my_max{int}` и `my_max{double}` — две разные функции в бинарнике,
//  без всяких накладных расходов во время выполнения.
//
//  Проверка типов происходит в момент инстанцирования. `my_max{String}`
//  не скомпилируется: строки нельзя сравнивать через `>`. Ошибка укажет
//  на строку внутри generic-функции — привыкайте читать такие сообщения
//  вместе с подсказкой "Inlined from here"/местом вызова.
//
//  Параметры бывают двух видов:
//    * типы — имя в стиле типа: `Type`, `Elem`, `Key`, `Value`;
//    * константы (int, bool, enum) — имя КАПСОМ: `N`, `SIZE`, `CAP`.
//
//      fn Type add_n(Type x) <Type, N> => x + N;
//      add_n{int, 5}(3);   // 8
//
//  ПОДВОДНЫЙ КАМЕНЬ: в C3 тип обязан начинаться с заглавной буквы и
//  содержать хотя бы одну строчную. Поэтому привычное по C++/Java `<T>`
//  НЕ работает: `T` — это имя КОНСТАНТЫ, и вы получите "A type name was
//  expected here". Пишите `<Type>`, `<Elem>`, `<Tval>`.
//
//  Generic-функции отлично сочетаются со срезами: `Type[] xs` — срез
//  элементов любого типа.
//
//  ЗАДАЧА:
//    1. Сделайте `my_max` generic-функцией (добавьте параметр-тип).
//    2. Исправьте вызовы, которым не хватает параметров.
//    3. Объявите `alias max_double` — версию `my_max` для `double`.
//    4. Реализуйте тело `sum` — сумма всех элементов среза.
//
import std::io;

fn Type my_max(Type a, Type b) <Type>
{
    return a > b ? a : b;
}

alias max_double = my_max{double};

fn Elem sum(Elem[] items) <Elem>
{
    Elem total;          // нулевая инициализация: 0 для любого числа
    foreach (x : items) total += x;
    return total;
}

fn Type add_n(Type x) <Type, N> => x + N;

fn void main()
{
    int a = my_max{int}(3, 7);
    assert(a == 7);
    io::printfn("max int:    %d", a);

    double b = max_double(1.5, -2.0);
    assert(b == 1.5);
    io::printfn("max double: %.1f", b);

    char c = my_max{char}('a', 'z');
    io::printfn("max char:   %c", c);

    int[] ints = { 1, 2, 3, 4, 5 };
    int s = sum{int}(ints);
    assert(s == 15);
    io::printfn("sum ints:   %d", s);

    double[3] ds = { 0.5, 0.25, 0.125 };
    double sd = sum{double}(&ds);
    assert(sd == 0.875);
    io::printfn("sum doubles: %.3f", sd);

    io::printfn("add_n:      %d", add_n{int, 5}(3));
}
