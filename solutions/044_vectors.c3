// =====================================================================
//  044 · SIMD-вектора `int[<4>]`, swizzle, редукции
// =====================================================================
//
//  Обратите внимание на угловые скобки: `int[4]` — массив, а
//  `int[<4>]` — ВЕКТОР. (Не путать с `std::vector` из C++ — это
//  List из стандартной библиотеки.) Вектор — это маленький набор чисел
//  фиксированной длины, над которым операции выполняются ПОЭЛЕМЕНТНО,
//  и компилятор старается использовать для этого SIMD-инструкции
//  процессора (SSE/AVX/NEON) — одна инструкция на все элементы сразу.
//
//      float[<4>] a = { 1, 2, 3, 4 };
//      float[<4>] b = a * 2 + 1;      // { 3, 5, 7, 9 }
//      float[<4>] c = 0.5;            // скаляр «размножается»: { .5, .5, .5, .5 }
//
//  Элементы — только числа, bool или указатели. Работают индексация
//  `a[2]`, `foreach`, `.len`, присваивание в массив и обратно.
//
//  SWIZZLE — выборка/перестановка компонентов по именам x y z w
//  (или r g b a для цветов):
//
//      int[<3>] v = { 11, 22, 33 };
//      v.x         // 11
//      v.zyx       // { 33, 22, 11 }
//      v.xxy       // { 11, 11, 22 } — повторять можно
//      v.xy = v.yx // и присваивать
//
//  РЕДУКЦИИ и полезные методы (без всяких import):
//      .sum() .product() .max() .min()   — свести вектор к одному числу
//      .dot(other)                       — скалярное произведение
//      .length() .normalize() .distance(o) — только для float/double
//
//  СРАВНЕНИЯ. `==` и `!=` сравнивают вектора целиком и дают `bool`.
//  А `<`, `>` и т.п. к векторам применять НЕЛЬЗЯ — нужны поэлементные
//  методы `.comp_lt/.comp_le/.comp_gt/.comp_ge/.comp_eq/.comp_ne`, которые
//  возвращают вектор bool'ов. Аргумент — тоже вектор (скаляр сам не
//  «размножится», напишите `{ 0, 0, 0, 0 }` или заведите переменную).
//  Вектор bool'ов сворачивается через `.and()` (все true?) и `.or()`
//  (хоть один true?).
//
//  `%s` печатает вектор как `[<1, 2, 3>]`.
//
//  ЗАДАЧА: почините три места, помеченные `// <-`.
//
import std::io;

fn void main()
{
    // Четыре юнита: здоровье и полученный урон за ход.
    int[<4>] hp = { 100, 40, 75, 10 };
    int[<4>] damage = { 30, 50, 25, 5 };
    hp -= damage;
    io::printfn("hp after hit: %s", hp);

    int total_damage = damage.sum(); // <- сумма всех элементов
    io::printfn("total damage: %d", total_damage);
    assert(total_damage == 110);

    int[<4>] zero = 0;
    bool[<4>] alive = hp.comp_gt(zero); // <- поэлементное «больше нуля»
    io::printfn("alive: %s, all alive: %s, anyone alive: %s",
                alive, alive.and(), alive.or());

    // Цвет RGB -> BGR перестановкой компонентов.
    char[<3>] rgb = { 0x11, 0x22, 0x33 };
    char[<3>] bgr = rgb.zyx; // <- переставьте компоненты в обратном порядке
    io::printfn("bgr: %s", bgr);
    assert(bgr == { 0x33, 0x22, 0x11 });

    float[<2>] dir = { 3, 4 };
    io::printfn("length %.1f, normalized %s", dir.length(), dir.normalize());
}
