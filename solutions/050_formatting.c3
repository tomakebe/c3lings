// =====================================================================
//  050 · Форматированный вывод в деталях
// =====================================================================
//
//  `io::printf` / `io::printfn` похожи на printf из C, но безопаснее:
//  аргументы передаются как `any...` (см. 049), поэтому функция ЗНАЕТ
//  их типы. Отсюда отличия от C:
//
//  * Никаких `%u`, `%ld`, `%lld`, `%zu` — `%d` печатает любое целое
//    (от ichar до int128), знаковое или нет.
//  * `%s` печатает ЧТО УГОДНО: строки, числа, bool (`true`), enum
//    (имя: `SHIELD`), массивы и срезы (`[1, 2, 3]`), вектора (`[<1, 2>]`).
//    Структуры без собственного `to_format` (см. 064) печатаются как
//    адрес — не полагайтесь на это.
//  * Количество аргументов проверяется НА ЭТАПЕ КОМПИЛЯЦИИ, если
//    форматная строка — литерал: лишний или недостающий аргумент —
//    ошибка компиляции.
//
//  Спецификаторы (то же, что в C, если не сказано иное):
//
//      %d   целое                      %c   символ:  'A' -> A
//      %x   hex строчными: ff          %X   hex заглавными: FF
//      %o   восьмеричное               %b   двоичное (в C такого нет!)
//      %f   дробное, 6 знаков          %e   экспоненциальная запись
//      %s   «что угодно»               %%   сам знак процента
//      %p   указатель
//
//  Модификаторы между `%` и буквой:
//
//      %5d    ширина 5, выравнивание вправо:  "   42"
//      %-5d   ширина 5, влево:                "42   "
//      %05d   дополнить нулями:               "00042"
//      %+d    всегда со знаком:               "+42"
//      %.2f   2 знака после точки:            "3.14"
//      %8.3f  ширина 8, 3 знака:              "   3.142"
//      %.3s   не больше 3 символов строки:    "abc"
//      %#x    с префиксом:                    "0xff"
//      %*d    ширина берётся из аргумента:    printfn("%*d", 6, 7)
//
//  Подвохи:
//  * `%x` для ОТРИЦАТЕЛЬНОГО числа печатает "-1", а не "ffffffff" как в C.
//    Нужны биты — приведите к беззнаковому: `(uint)x`.
//  * `char` через `%s` или `%d` печатается как число (65); для символа — `%c`.
//  * `io::printfn` возвращает `sz?` — число записанных байт или ошибку
//    ввода-вывода. Обычно результат просто игнорируют.
//
//  Те же форматы работают в `string::tformat(...)` (форматирование в
//  строку, подробнее в 057) и в `io::printf` без перевода строки.
//
//  ЗАДАЧА: программа печатает отчёт о складе. Почините строки,
//  помеченные `// <-`, чтобы вывод совпал с ожидаемым:
//
//      id     item        qty     price
//      0x00FF sword         1     12.50
//      0x0A10 arrow       120      0.25
//      0xBEEF potion        7      3.00
//      flags: 00000101
//      total: 63.50 (100%)
//
import std::io;

struct Item
{
    uint id;
    String name;
    int qty;
    double price;
}

fn void main()
{
    Item[3] items = {
        { 0xFF, "sword", 1, 12.5 },
        { 0xA10, "arrow", 120, 0.25 },
        { 0xBEEF, "potion", 7, 3.0 },
    };

    io::printfn("%-6s %-8s %6s %9s", "id", "item", "qty", "price");
    double total;
    foreach (it : items)
    {
        io::printfn("0x%04X %-8s %6d %9.2f", // <- id: 4 hex-цифры заглавными с нулями; имя — влево
                    it.id, it.name, it.qty, it.price); // <- цена: 2 знака после точки
        total += it.qty * it.price;
    }
    char flags = 0b101;
    io::printfn("flags: %08b", flags); // <- 8 двоичных разрядов с нулями
    io::printfn("total: %.2f (%d%%)", total, 100); // <- не хватает аргумента?
}
