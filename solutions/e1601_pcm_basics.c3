// =====================================================================
//  e1601 · PCM: сэмплы, форматы, преобразования
// =====================================================================
//
//  Звук в движке — это просто массив чисел. Микрофон (или синтезатор)
//  измеряет давление воздуха SAMPLE_RATE раз в секунду; каждое измерение —
//  «сэмпл». Такое представление называется PCM (pulse-code modulation).
//
//      амплитуда
//        +1 |    ..
//           |  .    .
//         0 +-.------.------.----> время (сэмплы)
//           |          .  .
//        -1 |           ..
//
//  Главные форматы сэмпла:
//
//    * float32 в диапазоне [-1, 1] — формат «внутри» микшера. Удобно:
//      можно складывать, умножать на громкость, временно выходить за ±1
//      без потерь (запас, headroom).
//    * int16 (short) в диапазоне [-32768, 32767] — формат файлов (WAV, CD)
//      и многих звуковых карт. Выход за пределы недопустим: число просто
//      переполнится и вместо громкого звука вы услышите треск.
//
//  Преобразование float -> int16 требует трёх вещей:
//    1. ограничения (clamp) в [-1, 1] — иначе переполнение short;
//    2. масштабирования на 32767 (симметричная шкала, -1.0 -> -32767);
//    3. округления к ближайшему (а не отбрасывания дробной части!):
//       отбрасывание даёт систематическое смещение к нулю — это шум.
//  Обратно: int16 -> float = s / 32768.0f (так -32768 даёт ровно -1.0).
//
//  Многоканальный звук хранят «перемежённо» (interleaved):
//      L0 R0 L1 R1 L2 R2 ...
//  Один «кадр» (frame) — это по сэмплу на каждый канал. Внутри микшера
//  часто удобнее «планарный» вид (отдельный массив на канал) — тогда
//  DSP-цикл идёт по непрерывной памяти. Перевод между ними — обычная
//  задача на границе «движок <-> устройство».
//
//  Громкость человек слышит логарифмически, поэтому в аудиоредакторах
//  её задают в децибелах: gain = 10^(dB/20). -6 dB ≈ 0.5, -20 dB = 0.1.
//
//  ЗАДАЧА: реализуйте функции, помеченные TODO:
//    f32_to_s16     — clamp + масштаб 32767 + округление к ближайшему;
//    s16_to_f32     — деление на 32768;
//    interleave     — два планарных канала -> L R L R ...;
//    deinterleave   — обратная операция;
//    peak_s16       — максимальный модуль сэмпла (осторожно с -32768!).
//  Программа сама проверит себя и напечатает контрольные суммы.
//
import std::io;

fn short f32_to_s16(float x)
{
    if (x > 1.0f) x = 1.0f;
    if (x < -1.0f) x = -1.0f;
    float scaled = x * 32767.0f;
    return (short)(scaled >= 0 ? scaled + 0.5f : scaled - 0.5f);
}

fn float s16_to_f32(short s)
{
    return (float)s / 32768.0f;
}

// left/right: планарные каналы одинаковой длины; out: 2 * left.len сэмплов.
fn void interleave(float[] left, float[] right, float[] out)
{
    assert(left.len == right.len && out.len == left.len * 2);
    foreach (i, l : left)
    {
        out[2 * i] = l;
        out[2 * i + 1] = right[i];
    }
}

fn void deinterleave(float[] interleaved, float[] left, float[] right)
{
    assert(left.len == right.len && interleaved.len == left.len * 2);
    for (usz i = 0; i < left.len; i++)
    {
        left[i] = interleaved[2 * i];
        right[i] = interleaved[2 * i + 1];
    }
}

// Пиковое значение по модулю. Внимание: -(-32768) не помещается в short.
fn int peak_s16(short[] samples)
{
    int peak = 0;
    foreach (s : samples)
    {
        int a = s < 0 ? -(int)s : (int)s;
        if (a > peak) peak = a;
    }
    return peak;
}

// ---------------------------------------------------------------------
// Ниже ничего менять не нужно.

fn uint fnv1a_s16(short[] data)
{
    uint h = 2166136261;
    foreach (s : data)
    {
        ushort u = (ushort)s;
        h = (h ^ (u & 0xFF)) * 16777619;
        h = (h ^ (u >> 8)) * 16777619;
    }
    return h;
}

// Детерминированный «синтезатор»: треугольная волна без libm.
fn float tri(int i, int period)
{
    int p = i % period;
    float t = (float)p / (float)period;      // 0..1
    return t < 0.5f ? 4.0f * t - 1.0f : 3.0f - 4.0f * t;
}

fn void main()
{
    // 1. граничные случаи преобразования
    assert(f32_to_s16(0.0f) == 0);
    assert(f32_to_s16(1.0f) == 32767);
    assert(f32_to_s16(-1.0f) == -32767);
    assert(f32_to_s16(1.7f) == 32767, "clamp сверху не работает");
    assert(f32_to_s16(-3.0f) == -32767, "clamp снизу не работает");
    assert(f32_to_s16(0.5f) == 16384, "нужно округлять к ближайшему: 16383.5 -> 16384");
    assert(f32_to_s16(-0.5f) == -16384, "округление отрицательных: -16383.5 -> -16384");
    assert(s16_to_f32(-32768) == -1.0f);
    assert(s16_to_f32(16384) == 0.5f);
    io::printn("convert: ok");

    // 2. interleave / deinterleave
    const N = 64;
    float[N] l;
    float[N] r;
    for (int i = 0; i < N; i++)
    {
        l[i] = tri(i, 16) * 0.8f;
        r[i] = tri(i + 4, 32) * 1.25f;   // правый канал «перегружен»
    }
    float[N * 2] inter;
    interleave(&l, &r, &inter);
    assert(inter[0] == l[0] && inter[1] == r[0] && inter[11] == r[5]);
    float[N] l2;
    float[N] r2;
    deinterleave(&inter, &l2, &r2);
    for (int i = 0; i < N; i++) assert(l2[i] == l[i] && r2[i] == r[i]);
    io::printn("interleave: ok");

    // 3. в int16
    short[N * 2] pcm;
    foreach (i, x : inter) pcm[i] = f32_to_s16(x);
    int peak = peak_s16(&pcm);
    short[3] edge = { 5, -32768, 100 };
    assert(peak_s16(&edge) == 32768, "peak(-32768) должен быть 32768");
    io::printfn("frames=%d peak=%d", N, peak);
    io::printfn("checksum=%08x", fnv1a_s16(&pcm));

    // 4. децибелы: -6 dB примерно вдвое тише
    short q = f32_to_s16(0.501187f);   // 10^(-6/20)
    io::printfn("-6dB as s16 = %d", q);
}
