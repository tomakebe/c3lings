// =====================================================================
//  069 · assert, unreachable, паника и safe-режим
// =====================================================================
//
//  Optional (031–036) — для ОЖИДАЕМЫХ ошибок: файла нет, строка не
//  число. Но бывают ошибки ПРОГРАММИСТА: индекс за границей массива,
//  «невозможная» ветка switch, нарушенный инвариант. Их не обрабатывают —
//  их находят и исправляют. Для этого в C3 есть паника: программа
//  печатает сообщение и стек вызовов в stderr и аварийно завершается.
//
//  Инструменты:
//
//      assert(cond);                         // паника, если cond ложно
//      assert(cond, "x was %d", x);          // ...с форматированным сообщением
//      unreachable("bad state %d", s);       // «сюда мы попасть не должны»
//      abort("fatal: %s", why);              // безусловная паника
//      $assert(int::size == 4);              // проверка ВО ВРЕМЯ КОМПИЛЯЦИИ
//
//  Плюс то, что компилятор вставляет сам в safe-режиме:
//    * проверка границ массивов и срезов:
//        ERROR: 'Array index out of bounds (array had size 3, index was 3)'
//    * проверка контрактов `@require` / `@ensure` (042);
//    * `!!` на пустом Optional, разыменование null, деление на ноль,
//      использование временной памяти после @pool (0xAA) и т.п.
//
//  SAFE-РЕЖИМ. По умолчанию c3c собирает в отладочном safe-режиме, где
//  всё это проверяется. Флаг `--safe=no` (и оптимизированные сборки)
//  убирает проверки: `assert` и `unreachable` становятся подсказками
//  оптимизатору, и нарушение — это уже неопределённое поведение, как в C.
//  Поэтому:
//    * assert — для инвариантов, а не для проверки пользовательского
//      ввода (ввод проверяйте обычным кодом и Optional'ами);
//    * в assert не пишите побочных эффектов: `assert(list.pop()...)`
//      в release-сборке может вообще не выполниться.
//    * если проверка нужна всегда — есть `always_assert(...)`.
//
//  Как читать панику: первая строка — что случилось, дальше — где
//  (файл:строка) и через какие функции мы туда пришли. Это лучший
//  друг при отладке — `./c3lings run 69` покажет её целиком.
//
//  ЗАДАЧА: программа падает. Запустите её, прочитайте сообщения паники
//  и исправьте ошибки (их две, по одной на запуск). Ожидаемый вывод:
//      #ff8800 -> r=255 g=136 b=0
//      #1a2b3c -> r=26 g=43 b=60
//      checksum = 8
//
import std::io;

struct Rgb
{
    int r, g, b;
}

fn int hex_digit(char c)
{
    switch (c)
    {
        case '0'..'9': return c - '0';
        case 'a'..'f': return c - 'a' + 10;
        default: unreachable("not a hex digit: '%c'", c);
    }
}

<* @require s.len == 7 && s[0] == '#' : "expected #rrggbb" *>
fn Rgb parse_color(String s)
{
    return {
        hex_digit(s[1]) * 16 + hex_digit(s[2]),
        hex_digit(s[3]) * 16 + hex_digit(s[4]),
        hex_digit(s[5]) * 16 + hex_digit(s[6]),
    };
}

fn void main()
{
    $assert(Rgb::size == 3 * int::size);

    String[2] inputs = { "#ff8800", "#1a2b3c" };
    Rgb[2] colors;
    foreach (i, s : inputs)
    {
        colors[i] = parse_color(s);
        io::printfn("%s -> r=%d g=%d b=%d", s, colors[i].r, colors[i].g, colors[i].b);
    }

    // контрольная сумма: сумма всех компонент по модулю 256
    int checksum;
    for (int i = 0; i < colors.len; i++)
    {
        checksum += colors[i].r + colors[i].g + colors[i].b;
    }
    checksum %= 256;
    assert(checksum == 8, "checksum was %d", checksum);
    io::printfn("checksum = %d", checksum);
}
