// =====================================================================
//  057 · Форматирование в строку: format, tformat, bformat
// =====================================================================
//
//  `io::printfn` печатает сразу в stdout. А если отформатированный
//  текст нужен как значение — положить в структуру, вернуть из функции,
//  записать в файл? В C для этого есть sprintf/snprintf (и вечные
//  переполнения буфера). В C3 — три функции модуля `string` с ТЕМИ ЖЕ
//  спецификаторами, что и у printf (%d %s %x %05d %-8s %.2f ...):
//
//    string::format(allocator, fmt, ...)
//        Выделяет ровно нужное количество памяти в `allocator` и
//        возвращает String. Владеет результатом вызывающий:
//            String s = string::format(mem, "%d", 42);
//            defer free(s);
//
//    string::tformat(fmt, ...)
//        То же самое в `tmem` (см. 052): освобождать не нужно, живёт
//        до конца текущего @pool. Самый частый вариант.
//
//    string::bformat(buffer, fmt, ...)
//        Форматирует в ВАШ буфер (`char[]`), вообще без выделения
//        памяти, и возвращает String-вид на заполненную часть буфера.
//        Если текст не влезает — это не тихое обрезание, как у
//        snprintf, и не порча памяти, как у sprintf, а паника
//        BUFFER_EXCEEDED. Буфер нужно брать с запасом.
//            char[16] buf;
//            String code = string::bformat(&buf, "#%04d", 7); // "#0007"
//
//  Напоминание по спецификаторам ширины (подробно было в 050):
//      %5d    — ширина 5, выравнивание вправо     "   42"
//      %-5d   — выравнивание влево                "42   "
//      %05d   — дополнение нулями                 "00042"
//      %-8s / %8s — то же для строк
//
//  Форматирование в строку — основа функций «представить значение
//  текстом»: денежные суммы, коды, таблицы, имена файлов.
//
//  ЗАДАЧА:
//    1. `money` должна выделять результат в переданном аллокаторе
//       и всегда печатать копейки двумя цифрами (3.05, а не 3.5).
//    2. Буфер для кода заказа слишком мал — программа паникует.
//  Ожидаемый вывод (обратите внимание на выравнивание):
//      order #0042
//      tea         3.05
//      cake       12.50
//      sandwich    7.00
//      total      22.55
//
import std::io;

fn String money(Allocator allocator, int cents)
{
    return string::format(allocator, "%d.%02d", cents / 100, cents % 100);
}

struct Item
{
    String name;
    int cents;
}

fn void main()
{
    @assert_leak()
    {
        Item[] items = { { "tea", 305 }, { "cake", 1250 }, { "sandwich", 700 } };

        char[12] buf;   // форматируем без выделения памяти
        String code = string::bformat(&buf, "order #%04d", 42);
        io::printn(code);

        int total;
        foreach (item : items)
        {
            @pool()
            {
                io::printfn("%-8s%8s", item.name, money(tmem, item.cents));
            };
            total += item.cents;
        }

        String t = money(mem, total);
        defer free(t);
        assert(t == "22.55");
        io::printfn("%-8s%8s", "total", t);
    };
}
