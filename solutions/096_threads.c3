// =====================================================================
//  096 · Потоки
// =====================================================================
//
//  Поток (thread) — независимый поток выполнения внутри одного
//  процесса. Все потоки делят общую память: глобальные переменные,
//  кучу, даже стек друг друга (если есть указатель). Это и сила, и
//  главный источник ошибок многопоточности.
//
//  В C3 потоки живут в модуле std::thread (обёртка над pthreads на
//  Linux/macOS и над WinAPI на Windows):
//
//      import std::thread;
//
//      fn int worker(void* arg)         // alias ThreadFn = fn int(void* arg);
//      {
//          Job* job = arg;              // void* неявно приводится к Job*
//          ...
//          return 0;                    // код возврата потока
//      }
//
//      Thread t;
//      t.create(&worker, &job)!!;       // запустить; ошибка -> Optional
//      int code = t.join()!!;           // дождаться завершения
//
//  `create` возвращает `void?`: создать поток может не получиться
//  (лимит ОС, нет памяти), поэтому результат надо обработать — здесь
//  `!!` (паника при ошибке). Лямбда без захвата тоже годится:
//  `t.create(fn int(void* a) => 42, null)!!;`.
//
//  join — обязательно. Пока вы не сделали join, поток может ещё
//  работать, и всё, что он пишет, читать НЕЛЬЗЯ: вы получите либо
//  старое значение, либо наполовину записанное. join — это ещё и точка
//  синхронизации памяти: всё, что поток записал до своего завершения,
//  гарантированно видно после join. Если ждать поток не нужно —
//  `t.detach()` (но тогда о его памяти заботьтесь сами). В отличие от
//  C++ std::thread, забытый join не приводит к std::terminate — поток
//  просто «утекает», а main может завершиться раньше него.
//
//  Как раздавать работу без гонок. Самый простой и самый надёжный
//  способ — у каждого потока СВОЯ структура с входными данными и
//  местом для результата:
//
//      struct Job { int lo; int hi; long result; }
//      Job[4] jobs;       // jobs[i] пишет только поток i
//
//  Никто ни с кем не делит записываемые данные — значит, не нужны ни
//  мьютексы, ни атомики. Главный поток читает jobs[i].result только
//  ПОСЛЕ join. Это шаблон «fork-join» (то же, что делает
//  std::thread::scope в Rust или std.Thread.spawn + join в Zig).
//
//  Гонка данных (data race) — когда два потока обращаются к одной
//  ячейке памяти без синхронизации и хотя бы один пишет. Например, все
//  потоки делают `total += x` в общую переменную: `+=` — это
//  «прочитать, сложить, записать», и два потока легко перетрут
//  результаты друг друга. Результат меняется от запуска к запуску, а
//  в отладке «всё работает». Ловить такие ошибки помогает
//  `c3c compile --sanitize=thread`.
//
//  Ещё два полезных факта:
//    * указатель &jobs[i] должен жить, пока жив поток. Передать адрес
//      локальной переменной цикла, которая тут же перезапишется, —
//      классическая ошибка;
//    * `tlocal int x;` — переменная, у каждого потока своя копия
//      (thread-local storage, как _Thread_local в C).
//
//  Вывод программы должен быть детерминированным: потоки завершаются
//  в непредсказуемом порядке, поэтому печатаем всё из main, после join,
//  в порядке индексов.
//
//  ЗАДАЧА: посчитайте количество простых чисел меньше 200000 в
//  4 потоках: каждый поток проверяет свой диапазон [lo, hi).
//    1. Допишите тело worker.
//    2. Запустите потоки (замените ???).
//    3. Дождитесь их завершения перед тем, как читать результаты.
//
//  Ожидаемый вывод:
//      [0, 50000): 5133 primes
//      [50000, 100000): 4459 primes
//      [100000, 150000): 4256 primes
//      [150000, 200000): 4136 primes
//      total: 17984
//
import std::io, std::thread;

const int LIMIT = 200_000;
const int THREADS = 4;

struct Range
{
    int lo;
    int hi;
    int count;   // результат: пишет только «свой» поток
}

fn bool is_prime(int n)
{
    if (n < 2) return false;
    for (int d = 2; d * d <= n; d++)
    {
        if (n % d == 0) return false;
    }
    return true;
}

fn int worker(void* arg)
{
    Range* r = arg;
    // TODO: посчитайте простые числа в [r.lo, r.hi) и запишите в r.count
    for (int n = r.lo; n < r.hi; n++)
    {
        if (is_prime(n)) r.count++;
    }
    return 0;
}

fn void main()
{
    Range[THREADS] ranges;
    Thread[THREADS] threads;
    int step = LIMIT / THREADS;

    for (int i = 0; i < THREADS; i++)
    {
        ranges[i] = { .lo = i * step, .hi = (i + 1) * step };
        threads[i].create(&worker, &ranges[i])!!;
    }

    // TODO: дождитесь завершения всех потоков
    foreach (t : threads) t.join()!!;

    int total = 0;
    foreach (r : ranges)
    {
        io::printfn("[%d, %d): %d primes", r.lo, r.hi, r.count);
        total += r.count;
    }
    io::printfn("total: %d", total);
}
