// =====================================================================
//  078 · Макросы с trailing-блоком `@body`
// =====================================================================
//
//  Вы уже пользовались конструкцией вида
//
//      @pool()
//      {
//          ...
//      };
//
//  Это не встроенный синтаксис языка, а обычный макрос из std, который
//  принимает БЛОК КОДА (trailing body — «хвостовой блок»). Так в C3
//  создают собственные управляющие конструкции.
//
//  Объявление: после обычных параметров ставится `;` и описание блока:
//
//      macro @repeat(int n; @body(int i))
//      {
//          for (int i = 0; i < n; i++)
//          {
//              @body(i);        // «вставить сюда блок, передав ему i»
//          }
//      }
//
//  Вызов: после аргументов `;` и имена параметров блока, затем сам
//  блок и ОБЯЗАТЕЛЬНАЯ `;` после закрывающей скобки:
//
//      @repeat(3; int i)
//      {
//          io::printfn("i = %d", i);
//      };
//
//  Тип параметров блока можно не писать — `@repeat(3; i) { ... };` — он
//  берётся из объявления. Если у блока параметров нет: `@body()` в
//  объявлении и просто `@section("load") { ... };` при вызове.
//
//  Как это работает. Блок встраивается целиком в место `@body(...)` — без
//  функций, указателей и замыканий. Аналоги:
//    * C: `#define FOR_EACH(x, list) for (...)` + блок после макроса —
//      работает, но хрупко и без типов;
//    * C++/Rust: лямбда, передаваемая в функцию (`for_each(v, [&](auto x)
//      {...})`) — нужен вызов функции и захват переменных;
//    * в C3 блок видит ВСЕ локальные переменные вызывающего кода
//      напрямую, никаких захватов: можно накапливать сумму во внешней
//      переменной.
//
//  Важные детали семантики:
//    * `return` внутри блока выходит из ВНЕШНЕЙ функции (той, где
//      написан блок), а не из макроса. Это как `return` внутри `for`.
//    * `break`/`continue` в блоке не видят циклов внутри макроса — для
//      компилятора блок написан снаружи, где цикла нет.
//    * Блок может вызываться ноль, один или много раз — решает макрос.
//    * Макросы с `@body` обязаны называться с `@` (как и с `#`-параметрами):
//      читатель должен видеть, что это не обычный вызов.
//
//  Типичные применения: обход своих структур данных, «обёртки» вида
//  «сделать что-то до и после» (замер времени, блокировка мьютекса,
//  временная арена `@pool`), повтор, ретраи.
//
//  ЗАДАЧА:
//    1. Допишите объявление `@repeat` (блок получает номер итерации).
//    2. В `@section` вызовите блок между строками begin и end.
//    3. Реализуйте `@each_even`: вызывает блок для элементов с чётными
//       индексами (0, 2, 4, ...), передавая индекс и значение.
//
import std::io;

macro @repeat(int n; @body(int i))
{
    for (int i = 0; i < n; i++)
    {
        @body(i);
    }
}

macro @section(String name; @body())
{
    io::printfn("[%s] begin", name);
    @body();
    io::printfn("[%s] end", name);
}

macro @each_even(arr; @body(idx, value))
{
    for (usz i = 0; i < arr.len; i += 2)
    {
        @body(i, arr[i]);
    }
}

fn int first_big(int[] values, int limit)
{
    @each_even(values; idx, v)
    {
        if (v > limit) return v;   // выходит из first_big!
    };
    return -1;
}

fn void main()
{
    @repeat(3; int i)
    {
        io::printfn("hello #%d", i);
    };

    @section("load")
    {
        io::printn("loading assets...");
    };

    int[] data = { 10, 11, 12, 13, 14, 15 };
    int total;
    @each_even(data; usz idx, int v)
    {
        io::printfn("data[%d] = %d", idx, v);
        total += v;      // блок видит локальные переменные main
    };
    assert(total == 36);
    io::printfn("total of even positions = %d", total);

    assert(first_big(data, 11) == 12);
    io::printfn("first_big = %d", first_big(data, 11));
    io::printfn("none      = %d", first_big(data, 100));
}
