// =====================================================================
//  077 · Ленивые аргументы `#expr` и @-макросы
// =====================================================================
//
//  Обычный макрос вычисляет аргументы заранее и работает с КОПИЯМИ.
//  Поэтому такой swap ничего не меняет у вызывающего:
//
//      macro swap(a, b) { var t = a; a = b; b = t; }   // меняет копии!
//
//  Нужен другой вид параметра — выражение, которое НЕ вычисляется при
//  вызове, а подставляется в тело макроса как есть. Такие параметры
//  помечаются решёткой `#`:
//
//      macro void @swap(#a, #b)
//      {
//          var t = #a;
//          #a = #b;
//          #b = t;
//      }
//      @swap(x, y);            // x и y действительно поменялись
//      @swap(arr[0], arr[2]);  // работает с любым присваиваемым выражением
//
//  Каждое упоминание `#a` в теле — это повторное вычисление выражения
//  в контексте ВЫЗЫВАЮЩЕГО кода. Это очень похоже на макросы C, но:
//    * подставляется выражение целиком (как дерево), так что проблема
//      приоритета операций, требующая скобок, не возникает;
//    * имена из выражения связываются там, где оно написано, а не внутри
//      макроса — `t` из `@swap(x, t)` никогда не спутается с локальной
//      `t` макроса (гигиена сохраняется).
//
//  Но и подводный камень C никуда не делся: если `#x` упомянут дважды,
//  то `@square_lazy(next())` вызовет `next()` ДВАЖДЫ. Если значение нужно
//  несколько раз — сохраните его: `var v = #x;`.
//
//  Почему `@` в имени? Макрос с `#`-параметрами (или с trailing-блоком,
//  см. следующее упражнение) может делать то, чего функция не может:
//  менять переменные вызывающего, НЕ вычислять аргумент, вычислять его
//  много раз. C3 требует, чтобы такой макрос назывался с `@` — тогда
//  читатель на месте вызова сразу видит: «осторожно, тут магия».
//  Без `@` компилятор выдаст: "Expression parameters are not allowed in
//  function-like macros. Prefix the macro name with '@'."
//
//  Ленивость полезна сама по себе. Аргумент можно не вычислять вовсе:
//
//      macro @or_else(value, #fallback)
//      {
//          if (value != 0) return value;
//          return #fallback;     // вычисляется, только если дошли сюда
//      }
//
//  Так устроены логирование «вычислять сообщение, только если уровень
//  включён», `assert` (сообщение не форматируется при успехе) и т.п.
//
//  Ещё одна суперсила `#`-параметров — `$stringify(#expr)`: текст
//  выражения в точности так, как его написали в месте вызова. Аналог `#x`
//  из препроцессора C:
//
//      macro @check(#cond) { ... $stringify(#cond) ... }
//      @check(a + 1 == 3);    // строка "a + 1 == 3"
//
//  ЗАДАЧА:
//    1. Перепишите `swap` так, чтобы он менял переменные вызывающего
//       (не забудьте про имя и места вызова).
//    2. Сделайте `@or_else` ленивым: дорогой запасной вариант не должен
//       вычисляться, если он не нужен.
//    3. В `@check` напечатайте текст проверяемого условия.
//
import std::io;

macro void @swap(#a, #b)
{
    var t = #a;
    #a = #b;
    #b = t;
}

macro @or_else(value, #fallback)
{
    if (value != 0) return value;
    return #fallback;
}

macro void @check(#cond)
{
    if (#cond)
    {
        io::printfn("PASS: %s", $stringify(#cond));
    }
    else
    {
        io::printfn("FAIL: %s", $stringify(#cond));
    }
}

int expensive_calls;
fn int expensive_default()
{
    expensive_calls++;
    return -1;
}

macro @square_lazy(#x) => #x * #x;

int counter;
fn int next() => ++counter;

fn void main()
{
    int x = 1;
    int y = 2;
    @swap(x, y);
    assert(x == 2 && y == 1);
    io::printfn("x = %d, y = %d", x, y);

    int[3] arr = { 10, 20, 30 };
    @swap(arr[0], arr[2]);
    assert(arr[0] == 30);
    io::printfn("arr = %s", arr);

    // Гигиена: снаружи тоже есть `t`, и это не мешает.
    int t = 99;
    @swap(x, t);
    io::printfn("x = %d, t = %d", x, t);

    int a = @or_else(5, expensive_default());
    int b = @or_else(0, expensive_default());
    io::printfn("a = %d, b = %d, expensive called %d time(s)", a, b, expensive_calls);
    assert(expensive_calls == 1, "fallback must be lazy");

    @check(x > 0);
    @check(arr[1] == 21);

    // Обратная сторона ленивости: next() вызывается дважды (1 * 2).
    io::printfn("square_lazy(next()) = %d", @square_lazy(next()));
}
