// =====================================================================
//  091 · Условная компиляция: @feat, $feat и флаг -D
// =====================================================================
//
//  В C условная компиляция делается препроцессором:
//
//      #ifdef DEBUG
//      void trace(const char* s) { printf("%s\n", s); }
//      #else
//      #define trace(s) ((void)0)
//      #endif
//
//  Препроцессор ничего не знает о языке: он режет текст, и в
//  выключенной ветке может лежать что угодно, даже синтаксический мусор.
//  Ошибка в ветке #ifdef WIN32 обнаружится только на Windows. В C3
//  препроцессора нет. Вместо него — два инструмента, которые работают
//  с уже разобранным кодом.
//
//  1) Атрибут @feat(...) на объявлениях верхнего уровня
//  -----------------------------------------------------
//
//      fn void trace(String s) @feat(VERBOSE) { io::printn(s); }
//      fn void trace(String s) @feat(!VERBOSE) { }
//
//  Объявление существует, только если выражение из «фич» истинно.
//  В выражении можно использовать только имена фич (ВЕРХНИЙ_РЕГИСТР)
//  и операторы `!`, `&`, `|`, скобки. Запятая на верхнем уровне
//  значит «или»: @feat(POSIX, WIN32) == @feat(POSIX | WIN32).
//  Два атрибута подряд — «и»: @feat(LINUX) @feat(BIG_ENDIAN).
//
//  Обратите внимание: две функции `trace` с одинаковым именем не
//  конфликтуют, потому что в каждой сборке существует ровно одна из них.
//  Если условия пересекутся (обе включены) — будет ошибка «повторное
//  определение»; если ни одна не включена — ошибка «нет такой функции»
//  в месте вызова. Компилятор следит за этим за вас.
//
//  @feat можно повесить и на целую секцию модуля:
//
//      module net::impl @feat(LINUX);
//      ...всё, что ниже, — только для Linux...
//
//  Компилятор сам выставляет много фич платформы: LINUX, WIN32, MACOS,
//  POSIX, BIG_ENDIAN и другие. Свои фичи вы задаёте флагом:
//
//      c3c compile -D VERBOSE -D DOUBLE_PRECISION main.c3
//
//  (в project.json — массив "features"). Фича — это просто флаг
//  «есть/нет», значений у неё нет: `-D LEVEL=3` компилятор отвергнет.
//  Числовые настройки делайте константами, выбранными через фичи.
//
//  2) $feat(NAME) — compile-time выражение типа bool
//  --------------------------------------------------
//
//  Внутри функций доступна вся мощь compile-time: $if, $switch и т.д.
//  `$feat(NAME)` возвращает true/false на этапе компиляции:
//
//      $if $feat(VERBOSE):
//          io::printn("verbose build");
//      $endif
//
//  Важно: на верхнем уровне `$if` запрещён (это сделано специально,
//  чтобы объявления не «появлялись из воздуха» и IDE могла понимать
//  код). Наверху — только @feat. Ещё одно место, где разрешён выбор
//  по фиче, — compile-time тернарный оператор в alias:
//
//      alias Real = $feat(DOUBLE_PRECISION) ? double : float;
//
//  В старых версиях C3 (до 0.8.3) были `@if($feature(X))` на верхнем
//  уровне — в 0.8.5 это заменено на @feat / $feat. В Zig аналог —
//  `if (builtin.os.tag == .linux)` + опции сборки из build.zig,
//  в Rust — `#[cfg(feature = "...")]`.
//
//  Как раннер передаёт флаги: для этого упражнения он компилирует
//  программу с `-D VERBOSE -D DOUBLE_PRECISION` (файл
//  checks/091_feat.flags).
//
//  ЗАДАЧА: замените три `???`:
//    * пустая версия `trace` должна существовать, когда VERBOSE НЕ задан;
//    * тип Real — double при DOUBLE_PRECISION, иначе float;
//    * блок в main печатает строку только в сборке с VERBOSE.
//
//  Ожидаемый вывод (с флагами раннера):
//      [trace] start
//      real size: 8
//      [trace] sum done
//      sum = 5.50
//      verbose build
//
import std::io;

fn void trace(String msg) @feat(VERBOSE)
{
    io::printfn("[trace] %s", msg);
}

fn void trace(String msg) @feat(!VERBOSE)
{
    // в «тихой» сборке ничего не делаем
}

// Работает на любой настольной ОС: пример фич, которые задаёт компилятор.
fn bool has_os() @feat(POSIX, WIN32) => true;
fn bool has_os() @feat(!POSIX & !WIN32) => false;

alias Real = $feat(DOUBLE_PRECISION) ? double : float;

fn void main()
{
    assert(has_os());
    trace("start");
    io::printfn("real size: %d", Real::size);

    Real[] values = { 1.0, 2.0, 2.5 };
    Real sum = 0;
    foreach (v : values) sum += v;
    trace("sum done");
    io::printfn("sum = %.2f", sum);

    $if $feat(VERBOSE):
        io::printn("verbose build");
    $endif
}
