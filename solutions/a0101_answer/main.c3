// Test harness for exercise a0101. DO NOT edit this file —
// edit answer.s. The harness calls your assembly function and checks the answer.
import std::io;

extern fn int asm_answer();

fn void main()
{
    int r = asm_answer();
    assert(r == 42, "asm_answer() returned %d, but should return 42", r);
    io::printfn("asm_answer() = %d", r);
}
