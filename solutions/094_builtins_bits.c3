// =====================================================================
//  094 · Встроенные функции $$… и битовые операции
// =====================================================================
//
//  Всё, что начинается с `$$`, — встроенное в компилятор (builtin).
//  Это не функции из библиотеки, а «дырки» прямо в бэкенд (LLVM).
//  Их две разновидности.
//
//  1) Встроенные КОНСТАНТЫ — подставляются при компиляции:
//
//      $$FUNC    имя текущей функции (String)
//      $$LINE    номер строки,  $$FILE — имя файла,  $$MODULE — модуль
//      $$DATE / $$TIME — дата и время сборки
//
//  Внутри макроса $$FUNC и $$LINE относятся к месту ВЫЗОВА макроса
//  (макрос раскрывается в вызывающую функцию). Поэтому логгер-макрос
//  «знает», откуда его позвали — как __func__/__LINE__ в C, но без
//  препроцессорных трюков:
//
//      macro void @trace(String msg) { io::printfn("[%s] %s", $$FUNC, msg); }
//
//  2) Встроенные ФУНКЦИИ: $$popcount, $$clz, $$ctz, $$bswap,
//  $$bitreverse, $$fshl/$$fshr (сдвиг «через» два числа = вращение),
//  $$sat_add, $$sqrt, $$memcpy, $$trap, $$unreachable и др. Каждая
//  превращается в одну-две машинные инструкции (popcnt, lzcnt, tzcnt,
//  bswap, rol...). В C это __builtin_popcount и компания, в Zig —
//  @popCount, @clz, @ctz, @byteSwap.
//
//  Но! Компилятор выдаёт предупреждение при прямом использовании $$-
//  функций в пользовательском коде: они считаются внутренней кухней.
//  Стандартная библиотека оборачивает их в удобные макросы-методы
//  (модуль std::bits и std::math), и пользоваться надо ими:
//
//      uint x = 0b1011_0000;
//      x.popcount()     // 3   — сколько единичных битов
//      x.clz()          // 24  — count leading zeros: нулей слева
//      x.ctz()          // 4   — count trailing zeros: нулей справа
//      x.rotl(8)        // вращение влево на 8 бит
//      bswap(x)         // разворот байтов (смена порядка байт, endianness)
//      bits::reverse(x) // разворот битов
//      c.sat_add(10)    // сложение с насыщением: 250 + 10 = 255 для char
//
//  Методы работают и для векторов: `int[<4>]`.popcount() считает
//  поэлементно.
//
//  Подводные камни:
//    * для нуля clz/ctz возвращают ширину типа (32 для uint) — в C
//      __builtin_clz(0) это UB, здесь определено, но лучше обрабатывать
//      ноль явно, если от этого зависит логика;
//    * результат зависит от ШИРИНЫ типа: (uint)1.clz() == 31, а
//      (ulong)1.clz() == 63. Следите, какого типа выражение;
//    * сдвиг на ширину типа и больше (`1u << 32`) — ошибка, так что в
//      next_pow2 случай x <= 1 надо разобрать отдельно;
//    * в C3 переполнение целых при обычной арифметике не UB, а
//      заворачивание (wrap). Нужен «потолок» — используйте sat_add.
//
//  Классические трюки:
//      x & (x - 1)       убирает младший единичный бит
//      x & -x            оставляет только младший единичный бит
//      (a ^ b).popcount() расстояние Хэмминга
//      31 - x.clz()      floor(log2(x)) для uint x > 0
//
//  ЗАДАЧА: реализуйте функции ниже, используя методы из std::bits и
//  трюки из шапки (циклов по битам не нужно!), и допишите макрос @trace.
//
//  Ожидаемый вывод:
//      [main] start
//      x=1 pow2=true next=1 log2=0
//      x=5 pow2=false next=8 log2=2
//      x=64 pow2=true next=64 log2=6
//      x=1000 pow2=false next=1024 log2=9
//      be32(0x11223344) = 0x44332211
//      hamming = 8
//      lowest bit of 0x50 = 4
//      [main] done
//
import std::io, std::bits;

// TODO: печатает "[<имя вызывающей функции>] <msg>"
macro void @trace(String msg)
{
    io::printfn("[%s] %s", $$FUNC, msg);
}

fn bool is_pow2(uint x)
{
    return x != 0 && (x & (x - 1)) == 0;
}

fn uint next_pow2(uint x)
{
    if (x <= 1) return 1;
    return 1u << (32 - (x - 1).clz());
}

fn int log2_floor(uint x)
{
    return 31 - x.clz();
}

fn uint be32(uint x)
{
    return bswap(x);
}

fn int hamming(ulong a, ulong b)
{
    return (a ^ b).popcount();
}

fn int lowest_bit(uint x)
{
    return x.ctz();
}

fn void main()
{
    @trace("start");
    uint[] samples = { 1, 5, 64, 1000 };
    foreach (x : samples)
    {
        io::printfn("x=%d pow2=%s next=%d log2=%d", x, is_pow2(x), next_pow2(x), log2_floor(x));
    }
    assert(!is_pow2(0));
    io::printfn("be32(0x11223344) = 0x%x", be32(0x11223344));
    io::printfn("hamming = %d", hamming(0xF0F0, 0xFF00));
    io::printfn("lowest bit of 0x50 = %d", lowest_bit(0x50));
    @trace("done");
}
